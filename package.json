{
	"name": "duneui",
	"type": "module",
	"version": "2.0.0",
	"packageManager": "pnpm@12.21.0",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src tests",
		"build": "tsc --noEmit && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"test:unit": "node --test tests/unit/*.test.ts",
		"test:e2e": "playwright test",
		"test:e2e:chromium": "playwright test --project=chromium",
		"test": "pnpm run test:unit && pnpm run test:e2e",
		"audit:security": "pnpm audit --audit-level=moderate"
	},
	"dependencies": {
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/partytown": "2.1.9",
		"@astrojs/react": "7.1.9",
		"@astrojs/sitemap": "^3.7.5",
		"@astrojs/vercel": "^11.0.22",
		"@fontsource-variable/albert-sans": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/urbanist": "^5.3.0",
		"@fontsource/instrument-serif": "^5.3.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"astro": "7.4.12",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"framer-motion": "14.14.0",
		"lucide-react": "1.73.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwind-merge": "3.7.0",
		"typescript": "6.0.3"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "^4.3.1",
		"@types/bun": "latest",
		"@types/node": "^26.0.1",
		"animated-tailwindcss": "4.0.0",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.14.0",
		"prettier": "3.10.1",
		"tailwindcss": "4.3.5",
		"tailwindcss-animate": "1.0.7",
		"typescript-eslint": "8.72.2"
	}
}
