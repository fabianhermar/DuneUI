---
import Container from './Container.astro'

const sections = [
	{
		index: '01',
		title: 'Primitives',
		links: [
			{ label: 'Accordion', href: '/components/accordion' },
			{ label: 'Alerts', href: '/components/alerts' },
			{ label: 'Buttons', href: '/components/buttons' },
			{ label: 'Badges', href: '/components/badges' },
			{ label: 'Cards', href: '/components/cards' },
			{ label: 'All Components →', href: '/components', isAccent: true }
		]
	},
	{
		index: '02',
		title: 'Patterns',
		links: [
			{ label: 'Avatar', href: '/components/avatar' },
			{ label: 'Breadcrumb', href: '/components/breadcrumb' },
			{ label: 'Button Group', href: '/components/button-group' },
			{ label: 'Dropdown', href: '/components/dropdown' },
			{ label: 'Forms', href: '/components/forms' },
			{ label: 'List Group', href: '/components/list-group' }
		]
	},
	{
		index: '03',
		title: 'Ecosystem',
		links: [
			{ label: 'Documentation', href: '/docs', external: false },
			{ label: 'Pure CSS Kit', href: '/css', external: false },
			{ label: 'Page Templates', href: '/templates', external: false },
			{ label: 'SVG Icons', href: '/icons', external: false },
			{ label: 'Changelog', href: '/changelog', external: false },
			{ label: 'FAQs & License', href: '/license', external: false },
			{ label: 'Sponsor Project', href: '/support', isAccent: true, external: false }
		]
	}
]
---

<footer class='border-t border-rule bg-paper-elevated text-ink'>
	<Container>
		<div class='grid grid-cols-1 gap-12 py-16 lg:grid-cols-12 lg:py-20'>
			<!-- Brand Column -->
			<div class='flex flex-col justify-between gap-8 lg:col-span-5'>
				<div>
					<div class='flex items-center gap-3'>
						<img
							src='/svg/DuneUI.svg'
							class='size-9'
							alt='DuneUI Logo'
							loading='lazy'
							decoding='async'
						/>
						<span class='font-heading text-2xl font-bold tracking-tight'>
							Dune<span class='font-serif italic font-normal text-clay'>UI</span>
						</span>
					</div>

					<p class='mt-5 max-w-sm font-accent text-sm leading-relaxed text-ink-secondary'>
						An open-source atelier of Tailwind CSS v4 and pure CSS interface primitives—crafted for teams who reject generic templates.
					</p>

					<div class='mt-6 inline-flex items-center gap-2 border border-rule bg-paper px-3 py-1.5 font-mono text-[11px] uppercase tracking-wider text-ink-secondary'>
						<span class='size-1.5 bg-clay'></span>
						<span>Free · Open Source · Copy-Paste</span>
					</div>
				</div>

				<div class='flex items-center gap-3'>
					<a
						href='https://x.com/FabianHermar'
						rel='noreferrer noopener'
						target='_blank'
						class='inline-flex items-center gap-2 border border-rule bg-paper px-3.5 py-2 font-mono text-xs text-ink-secondary transition-colors hover:border-ink hover:text-ink'
					>
						<span>X / Twitter</span>
						<span aria-hidden='true'>↗</span>
					</a>
					<a
						href='https://github.com/FabianHermar'
						rel='noreferrer noopener'
						target='_blank'
						class='inline-flex items-center gap-2 border border-rule bg-paper px-3.5 py-2 font-mono text-xs text-ink-secondary transition-colors hover:border-ink hover:text-ink'
					>
						<span>GitHub</span>
						<span aria-hidden='true'>↗</span>
					</a>
				</div>
			</div>

			<!-- Index Columns -->
			<div class='grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-7'>
				{
					sections.map((section) => (
						<div>
							<div class='mb-5 flex items-center gap-2 border-b border-rule pb-2.5'>
								<span class='font-mono text-[10px] text-clay'>{section.index}</span>
								<p class='font-mono text-xs font-semibold uppercase tracking-widest text-ink'>
									{section.title}
								</p>
							</div>
							<ul class='flex flex-col gap-2.5 font-accent text-sm'>
								{section.links.map((link) => (
									<li>
										<a
											href={link.href}
											target={link.external ? '_blank' : undefined}
											rel={link.external ? 'noreferrer noopener' : undefined}
											class={`inline-flex items-center gap-1 transition-colors ${
												link.isAccent
													? 'font-semibold text-clay hover:text-clay-deep'
													: 'text-ink-secondary hover:text-ink'
											}`}
										>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>

		<!-- Bottom Architectural Baseline -->
		<div class='flex flex-col items-center justify-between gap-4 border-t border-rule py-6 sm:flex-row'>
			<p class='font-mono text-xs text-ink-muted'>
				CRAFTED BY{' '}
				<a
					href='http://fabianh.me'
					aria-label='Visit the website of Fabian Herrera - Creator of Dune UI'
					target='_blank'
					rel='noopener noreferrer'
					class='font-semibold text-ink underline decoration-rule-strong underline-offset-4 transition-colors hover:text-clay hover:decoration-clay'
				>
					FABIAN HERRERA
				</a>
			</p>

			<div class='flex items-center gap-5 font-mono text-xs uppercase tracking-wider text-ink-muted'>
				<a href='/docs' class='transition-colors hover:text-ink'>Docs</a>
				<span aria-hidden='true'>/</span>
				<a href='/changelog' class='transition-colors hover:text-ink'>Changelog</a>
				<span aria-hidden='true'>/</span>
				<a href='/license' class='transition-colors hover:text-ink'>License</a>
				<span aria-hidden='true'>/</span>
				<a href='/faqs' class='transition-colors hover:text-ink'>FAQs</a>
			</div>
		</div>
	</Container>
</footer>
