---
import { Image } from 'astro:assets'

interface Props {
	index?: string
	title: string
	quantity: string
	href: string
	image: string
	alt?: string
	tag?: string
}

const { index = '00', title, quantity, href, image, alt, tag = 'UI' } = Astro.props
---

<a
	href={href}
	aria-label={`${title} — ${quantity}`}
	class='group relative flex flex-col justify-between border-b border-r border-rule bg-paper-elevated transition-colors duration-200 hover:bg-paper'
>
	<!-- Top Specimen Bar -->
	<div class='flex items-center justify-between border-b border-rule/70 px-4 py-3'>
		<div class='flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-ink-muted'>
			<span class='text-clay'>FIG.{index}</span>
			<span>/</span>
			<span>{tag}</span>
		</div>
		<span class='font-mono text-[10px] text-ink-muted'>
			{quantity}
		</span>
	</div>

	<!-- Wireframe Stage -->
	<div class='arch-dots-bg relative flex h-48 items-center justify-center overflow-hidden p-6'>
		<div class='transition-transform duration-300 ease-out group-hover:scale-[1.04]'>
			<Image
				src={image}
				alt={alt ?? title}
				width='220'
				height='180'
				loading='eager'
				class='max-h-36 w-auto object-contain drop-shadow-[0_6px_16px_rgba(22,20,18,0.08)] select-none'
			/>
		</div>
	</div>

	<!-- Footer Title Row -->
	<div class='flex items-center justify-between border-t border-rule/70 px-4 py-3.5'>
		<h3 class='font-heading text-lg font-bold tracking-tight text-ink transition-colors group-hover:text-clay'>
			{title}
		</h3>
		<span
			aria-hidden='true'
			class='inline-flex size-7 items-center justify-center border border-rule bg-paper font-mono text-xs text-ink-secondary transition-all duration-200 group-hover:border-clay group-hover:bg-clay group-hover:text-paper-elevated'
		>
			↗
		</span>
	</div>
</a>
