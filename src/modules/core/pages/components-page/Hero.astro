---
import Container from '@/core/components/Container.astro'
import ItemCard from '@/core/pages/landing-page/ItemCard.astro'
import { CARDS } from '@/constants/Card'

const tags = ['All', ...Array.from(new Set(CARDS.map((c) => c.tag)))]
---

<section class='border-b border-rule bg-paper pt-12 pb-16 sm:pt-16 sm:pb-24'>
	<Container>
		<!-- Directory Header -->
		<div class='mb-10 grid grid-cols-1 items-end gap-8 border-b border-rule pb-10 lg:grid-cols-12'>
			<div class='lg:col-span-8'>
				<div class='flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-clay'>
					<span>INDEX</span>
					<span class='text-rule-strong'>/</span>
					<span>{CARDS.length} CATEGORIES · {CARDS.length * 10} RESPONSIVE COMPONENTS</span>
				</div>
				<h1 class='mt-3 font-heading text-4xl font-bold leading-[1.02] tracking-tight text-ink sm:text-6xl'>
					Every component,{' '}
					<span class='font-serif italic font-normal text-clay'>distinctly styled.</span>
				</h1>
				<p class='mt-4 max-w-2xl font-accent text-base leading-relaxed text-ink-secondary'>
					Explore 10 completely different, mobile-first responsive designs inside every category—from Apple Liquid Glass and Linear dark ops to Neo-Brutalism, Stripe fintech, Editorial print, and Tailwind UI clean SaaS. Switch preview breakpoints live from 375px phone up to full width.{' '}
					<a href='/docs' class='font-semibold text-clay underline underline-offset-4 hover:text-clay-deep'>
						Read the setup &amp; framework docs →
					</a>
				</p>
			</div>

			<!-- Quick Filter Input -->
			<div class='lg:col-span-4'>
				<label for='directory-search' class='block font-mono text-[10px] uppercase tracking-widest text-ink-muted mb-2'>
					Filter {CARDS.length} Categories
				</label>
				<div class='flex items-center border border-rule-strong bg-paper-elevated px-3.5 py-2.5 focus-within:border-ink'>
					<span class='font-mono text-xs text-clay mr-2'>/</span>
					<input
						id='directory-search'
						type='search'
						placeholder='Search footers, heroes, pricing pages, auth...'
						class='w-full bg-transparent font-accent text-sm text-ink placeholder:text-ink-muted focus:outline-none'
					/>
				</div>
			</div>
		</div>

		<!-- Dedicated Standalone Suites -->
		<div class='mb-8 grid grid-cols-1 gap-3 sm:grid-cols-3'>
			<a href='/css' class='group flex items-center justify-between border border-rule bg-paper-elevated px-4 py-3 transition-colors hover:border-ink'>
				<div>
					<p class='font-mono text-[10px] uppercase tracking-widest text-clay'>01 / PURE CSS</p>
					<p class='mt-0.5 font-heading text-sm font-bold text-ink'>Zero-Tailwind Primitives</p>
				</div>
				<span class='font-mono text-xs text-ink-muted transition-transform group-hover:translate-x-0.5 group-hover:text-ink'>&rarr;</span>
			</a>
			<a href='/templates' class='group flex items-center justify-between border border-rule bg-paper-elevated px-4 py-3 transition-colors hover:border-ink'>
				<div>
					<p class='font-mono text-[10px] uppercase tracking-widest text-clay'>02 / BLUEPRINTS</p>
					<p class='mt-0.5 font-heading text-sm font-bold text-ink'>Complete Landing Templates</p>
				</div>
				<span class='font-mono text-xs text-ink-muted transition-transform group-hover:translate-x-0.5 group-hover:text-ink'>&rarr;</span>
			</a>
			<a href='/icons' class='group flex items-center justify-between border border-rule bg-paper-elevated px-4 py-3 transition-colors hover:border-ink'>
				<div>
					<p class='font-mono text-[10px] uppercase tracking-widest text-clay'>03 / NEOICONS</p>
					<p class='mt-0.5 font-heading text-sm font-bold text-ink'>SVG Icons Library</p>
				</div>
				<span class='font-mono text-xs text-ink-muted transition-transform group-hover:translate-x-0.5 group-hover:text-ink'>&rarr;</span>
			</a>
		</div>

		<!-- Category Tag Filters -->
		<div class='mb-8 flex flex-wrap items-center gap-2' id='directory-tags'>
			{
				tags.map((tag, idx) => (
					<button
						type='button'
						data-tag={tag}
						class={`cursor-pointer border px-3 py-1.5 font-mono text-[11px] uppercase tracking-wider transition-colors ${
							idx === 0
								? 'border-ink bg-ink text-paper-elevated'
								: 'border-rule bg-paper-elevated text-ink-secondary hover:border-ink hover:text-ink'
						}`}
					>
						{tag}
					</button>
				))
			}
		</div>

		<!-- All 40 Categories Grid -->
		<div id='directory-grid'>
			<ItemCard />
		</div>
	</Container>
</section>

<script>
	function initDirectorySearch() {
		const input = document.getElementById('directory-search') as HTMLInputElement | null
		const grid = document.getElementById('directory-grid')
		const tagBar = document.getElementById('directory-tags')
		if (!input || !grid) return

		if (input.getAttribute('data-bound') === 'true') return
		input.setAttribute('data-bound', 'true')

		let activeTag = 'All'

		function applyFilter() {
			if (!input || !grid) return
			const q = input.value.trim().toLowerCase()
			const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>('a'))
			cards.forEach((card) => {
				const text = (card.textContent || '').toLowerCase()
				const matchesSearch = text.includes(q)
				const matchesTag =
					activeTag === 'All' ||
					Array.from(card.querySelectorAll('span')).some(
						(el) => el.textContent?.trim().toLowerCase() === activeTag.toLowerCase()
					)
				card.style.display = matchesSearch && matchesTag ? '' : 'none'
			})
		}

		input.addEventListener('input', applyFilter)

		tagBar?.querySelectorAll<HTMLButtonElement>('button[data-tag]').forEach((btn) => {
			btn.addEventListener('click', () => {
				activeTag = btn.dataset.tag || 'All'
				tagBar.querySelectorAll<HTMLButtonElement>('button[data-tag]').forEach((b) => {
					const selected = b.dataset.tag === activeTag
					b.className = selected
						? 'cursor-pointer border px-3 py-1.5 font-mono text-[11px] uppercase tracking-wider transition-colors border-ink bg-ink text-paper-elevated'
						: 'cursor-pointer border px-3 py-1.5 font-mono text-[11px] uppercase tracking-wider transition-colors border-rule bg-paper-elevated text-ink-secondary hover:border-ink hover:text-ink'
				})
				applyFilter()
			})
		})
	}

	initDirectorySearch()
	document.addEventListener('astro:page-load', initDirectorySearch)
</script>
