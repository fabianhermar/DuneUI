---
import Container from '@/core/components/Container.astro'
---

<section class='relative overflow-hidden bg-obsidian py-20 text-paper-elevated sm:py-28'>
	<Container>
		<div class='grid grid-cols-1 items-end gap-10 lg:grid-cols-12'>
			<div class='lg:col-span-8'>
				<div class='flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-sand'>
					<span>05</span>
					<span class='text-white/30'>/</span>
					<span>SHIP WITH INTENTION</span>
				</div>
				<h2 class='mt-4 font-heading text-4xl font-bold leading-[1.02] tracking-tight sm:text-6xl'>
					Stop shipping interfaces that look{' '}
					<span class='font-serif italic font-normal text-sand'>auto-generated.</span>
				</h2>
				<p class='mt-6 max-w-xl font-accent text-base leading-relaxed text-white/70'>
					Every DuneUI component is free for personal and commercial work. Inspect the source, tweak the tokens, and make it unmistakably yours.
				</p>
			</div>

			<div class='flex flex-col gap-3 lg:col-span-4 lg:items-end'>
				<a
					href='/components'
					class='inline-flex w-full items-center justify-between gap-4 border border-sand bg-sand px-6 py-4 font-mono text-xs font-semibold uppercase tracking-widest text-obsidian transition-colors hover:bg-paper-elevated hover:border-paper-elevated lg:w-auto'
				>
					<span>Browse All Components</span>
					<span aria-hidden='true'>↗</span>
				</a>
				<a
					href='/changelog'
					class='inline-flex w-full items-center justify-between gap-4 border border-white/20 bg-obsidian-soft px-6 py-4 font-mono text-xs font-medium uppercase tracking-widest text-paper-elevated transition-colors hover:border-white/50 lg:w-auto'
				>
					<span>Read v2.0 Changelog</span>
					<span aria-hidden='true'>→</span>
				</a>
			</div>
		</div>
	</Container>
</section>
