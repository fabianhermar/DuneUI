---
import Container from '@/core/components/Container.astro'
import HeroWorkbench from './HeroWorkbench'
import { CARDS } from '@/constants/Card'
---

<section class='relative overflow-hidden border-b border-rule bg-paper pt-10 pb-16 sm:pt-14 sm:pb-24'>
	<!-- Subtle Architectural Drafting Grid -->
	<div aria-hidden='true' class='arch-grid-bg pointer-events-none absolute inset-0 opacity-55'></div>

	<Container>
		<div class='relative z-10 grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-10'>
			<!-- Left Editorial Column (7 cols) -->
			<div class='flex flex-col items-start lg:col-span-7 animate-reveal-up'>
				<!-- Technical Index Tag -->
				<a
					href='/changelog'
					class='group inline-flex items-center gap-3 border border-rule bg-paper-elevated px-3.5 py-1.5 transition-colors hover:border-ink'
				>
					<span class='font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-clay'>
						EDITION 2.0
					</span>
					<span class='h-3 w-px bg-rule' aria-hidden='true'></span>
					<span class='font-mono text-[11px] text-ink-secondary'>
						Tailwind CSS v4 + Pure CSS Primitives
					</span>
					<span class='font-mono text-xs text-ink-muted transition-transform group-hover:translate-x-0.5'>
						→
					</span>
				</a>

				<!-- Editorial Headline -->
				<h1 class='mt-7 font-heading text-[clamp(2.35rem,5.4vw,5.1rem)] font-bold leading-[1.02] tracking-[-0.03em] text-ink'>
					Interface primitives
					<span class='block mt-1'>
						sculpted with{' '}
						<span class='font-serif italic font-normal text-clay tracking-[-0.01em]'>
							architectural
						</span>{' '}
						clarity.
					</span>
				</h1>

				<!-- Editorial Subcopy -->
				<p class='mt-6 max-w-xl font-accent text-base leading-relaxed text-ink-secondary sm:text-lg'>
					DuneUI is an open-source collection of copy-paste UI components engineered for developers who are tired of generic templates. Zero runtime dependencies, strict semantic markup, and warm tactile craft.
				</p>

				<!-- Tactile CTA Row -->
				<div class='mt-9 flex flex-wrap items-center gap-4'>
					<a
						href='/components'
						id='hero-browse-btn'
						aria-label='Browse all components'
						class='tactile-btn inline-flex items-center gap-3 bg-ink px-6 py-3.5 font-mono text-xs font-semibold uppercase tracking-[0.14em] text-paper-elevated hover:bg-obsidian-soft'
					>
						<span>Browse Components</span>
						<span aria-hidden='true'>↗</span>
					</a>

					<a
						href='/support'
						id='hero-support-btn'
						aria-label='Support the project'
						class='inline-flex items-center gap-2.5 border border-rule-strong bg-paper-elevated px-5 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.12em] text-ink transition-colors hover:border-ink hover:bg-paper-recessed'
					>
						<span>Support Project</span>
					</a>
				</div>

				<!-- 4-Cell Hairline Specification Strip -->
				<div class='mt-12 grid w-full max-w-xl grid-cols-2 border border-rule bg-paper-elevated sm:grid-cols-4'>
					{[
						{ value: String(CARDS.length), label: 'Categories' },
						{ value: String(CARDS.length * 10), label: 'Responsive Specs' },
						{ value: 'TW v4', label: 'Native Ready' },
						{ value: '0 kB', label: 'JS Lock-in' }
					].map((stat, i) => (
						<div
							class={`flex flex-col gap-1 px-4 py-3.5 ${
								i > 0 ? 'border-t sm:border-t-0 sm:border-l border-rule' : ''
							} ${i === 1 ? 'border-l border-rule sm:border-t-0' : ''} ${
								i === 3 ? 'border-l border-rule' : ''
							}`}
						>
							<span class='font-heading text-xl font-bold tracking-tight text-ink'>
								{stat.value}
							</span>
							<span class='font-mono text-[10px] uppercase tracking-widest text-ink-muted'>
								{stat.label}
							</span>
						</div>
					))}
				</div>
			</div>

			<!-- Right Interactive Specimen Workbench (5 cols) -->
			<div class='lg:col-span-5 animate-reveal-up [animation-delay:120ms]'>
				<HeroWorkbench client:load />
			</div>
		</div>
	</Container>
</section>
