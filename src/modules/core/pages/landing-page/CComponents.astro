---
import Container from '@/core/components/Container.astro'
import ItemCard from '@/core/pages/landing-page/ItemCard.astro'
import { CARDS } from '@/constants/Card'
---

<section class='border-b border-rule bg-paper py-20 sm:py-28'>
	<Container>
		<!-- Asymmetric Section Header -->
		<div class='mb-12 grid grid-cols-1 items-end gap-6 lg:grid-cols-12'>
			<div class='lg:col-span-8'>
				<div class='flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-clay'>
					<span>02</span>
					<span class='text-rule-strong'>/</span>
					<span>COMPONENT ARCHIVE</span>
				</div>
				<h2 class='mt-3 font-heading text-3xl font-bold leading-[1.06] tracking-tight text-ink sm:text-5xl'>
					Curated interface blocks,{' '}
					<span class='font-serif italic font-normal text-clay'>engineered</span>{' '}
					for clarity.
				</h2>
			</div>

			<div class='flex flex-col items-start gap-4 lg:col-span-4 lg:items-end'>
				<p class='font-accent text-sm leading-relaxed text-ink-secondary lg:text-right'>
					{CARDS.length} UI families &amp; {CARDS.length * 10} responsive visual designs inspired by Dribbble, Tailwind UI, Liquid Glass, Linear, Stripe, and Neo-Brutalism.
				</p>
				<a
					href='/components'
					class='tactile-btn inline-flex items-center gap-2 bg-ink px-5 py-2.5 font-mono text-xs font-medium uppercase tracking-wider text-paper-elevated hover:bg-obsidian-soft'
				>
					<span>Browse All {CARDS.length} Families</span>
					<span aria-hidden='true'>↗</span>
				</a>
			</div>
		</div>

		<!-- Featured 12 Families Grid -->
		<ItemCard limit={12} />

		<div class='mt-8 flex flex-col items-center justify-between gap-4 border border-rule bg-paper-elevated px-6 py-4 sm:flex-row'>
			<span class='font-mono text-xs text-ink-secondary'>
				Plus {CARDS.length - 12} more categories: Heroes, Pricing Pages, Drawers, Selects, Shopping Carts, Checkouts, Product Pages, Filters &amp; more.
			</span>
			<a
				href='/components'
				class='shrink-0 font-mono text-xs font-semibold uppercase tracking-wider text-clay hover:underline'
			>
				View Full Directory ({CARDS.length}) →
			</a>
		</div>
	</Container>
</section>
