---
import Container from '@/core/components/Container.astro'
---

<section class='border-b border-rule bg-paper py-14 sm:py-20'>
	<Container>
		<div class='max-w-4xl mx-auto'>
			<div class='border-b border-rule pb-10'>
				<div class='flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-clay mb-3'>
					<span>PATRONAGE</span>
					<span class='text-rule-strong'>/</span>
					<span>SUPPORT DUNEUI</span>
				</div>
				<h1 class='font-heading text-4xl sm:text-6xl font-bold text-ink leading-[1.02] tracking-tight'>
					Back independent{' '}
					<span class='font-serif italic font-normal text-clay'>open-source</span>{' '}
					craft.
				</h1>
				<p class='mt-4 max-w-2xl font-accent text-base text-ink-secondary leading-relaxed'>
					DuneUI is completely free and open-source. Sponsorships fund ongoing component design, accessibility audits, Tailwind v4 maintenance, and new templates.
				</p>
			</div>

			<div class='mt-12 border border-ink bg-obsidian p-8 sm:p-10 text-paper-elevated shadow-[6px_6px_0_0_#B5542D]'>
				<div class='flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 border-b border-white/15 pb-6'>
					<div>
						<span class='font-mono text-[10px] uppercase tracking-widest text-sand'>DIRECT SPONSORSHIP</span>
						<h2 class='mt-2 font-heading text-2xl sm:text-3xl font-bold'>
							Sponsor DuneUI Development
						</h2>
					</div>
					<img
						alt='DuneUI'
						src='/svg/DuneUI.svg'
						class='size-12 shrink-0'
						loading='lazy'
						decoding='async'
					/>
				</div>

				<p class='mt-6 font-accent text-sm sm:text-base text-white/75 leading-relaxed max-w-2xl'>
					Every contribution helps us expand our component archive, improve documentation, and keep every primitive free forever without paywalls.
				</p>

				<div class='mt-8 flex flex-wrap gap-3'>
					<a
						href='https://buymeacoffee.com/fabianhermar'
						target='_blank'
						rel='noopener noreferrer'
						class='inline-flex items-center gap-2 bg-sand px-6 py-3 font-mono text-xs font-semibold uppercase tracking-widest text-obsidian transition-colors hover:bg-paper-elevated'
					>
						<span>Buy Me a Coffee</span>
						<span aria-hidden='true'>↗</span>
					</a>
					<a
						href='https://github.com/sponsors/fabianhermar'
						target='_blank'
						rel='noopener noreferrer'
						class='inline-flex items-center gap-2 border border-white/25 bg-obsidian-soft px-6 py-3 font-mono text-xs font-medium uppercase tracking-widest text-paper-elevated transition-colors hover:border-white/60'
					>
						<span>GitHub Sponsors</span>
						<span aria-hidden='true'>↗</span>
					</a>
				</div>
			</div>
		</div>
	</Container>
</section>
