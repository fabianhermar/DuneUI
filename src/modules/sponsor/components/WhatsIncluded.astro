---
import Container from '@/core/components/Container.astro'
---

<section class='bg-paper py-14 sm:py-20'>
	<Container>
		<div class='max-w-4xl mx-auto'>
			<div class='flex items-center gap-3 mb-8'>
				<span class='font-mono text-xs font-semibold text-clay'>02</span>
				<h2 class='font-heading text-2xl font-bold text-ink'>What Sponsorship Sustains</h2>
				<div class='flex-1 h-px bg-rule'></div>
			</div>

			<div class='grid grid-cols-1 border-l border-t border-rule sm:grid-cols-3'>
				{[
					{
						index: 'A',
						title: 'Application & Marketing UI',
						desc: 'Continuous additions across navigation, feedback, forms, and editorial page blocks.'
					},
					{
						index: 'B',
						title: 'Pure CSS & TW v4 Parity',
						desc: 'Maintaining clean utility markup alongside native CSS variable specimens.'
					},
					{
						index: 'C',
						title: 'Keyboard & ARIA Quality',
						desc: 'Cross-browser validation and semantic HTML5 craftsmanship on every release.'
					}
				].map((item) => (
					<div class='border-b border-r border-rule bg-paper-elevated p-6'>
						<span class='font-mono text-xs font-semibold text-clay'>{item.index}</span>
						<h3 class='mt-3 font-heading text-lg font-bold text-ink'>{item.title}</h3>
						<p class='mt-2 font-accent text-sm text-ink-secondary leading-relaxed'>{item.desc}</p>
					</div>
				))}
			</div>
		</div>
	</Container>
</section>
