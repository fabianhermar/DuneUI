---
import Layout from '@/layouts/Layout.astro'
import Container from '@/core/components/Container.astro'
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)

function formatDate(date: Date) {
	return date.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })
}

function getInitials(name: string) {
	return name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2)
}
---

<Layout
	title='Blog · DuneUI'
	description='Read the latest articles and updates on DuneUI, Tailwind CSS components, and templates.'
>
	<div class='bg-paper py-14 sm:py-20'>
		<Container>
			<!-- Editorial Header -->
			<div class='flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 border-b border-rule pb-12 mb-12'>
				<div>
					<div class='flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-clay mb-3'>
						<span>JOURNAL</span>
						<span class='text-rule-strong'>/</span>
						<span>NEWS &amp; NOTES</span>
					</div>
					<h1 class='font-heading text-4xl sm:text-6xl font-bold text-ink leading-[1.02] tracking-tight'>
						Dispatches from the{' '}
						<span class='font-serif italic font-normal text-clay'>atelier.</span>
					</h1>
					<p class='mt-4 max-w-md font-accent text-base text-ink-secondary leading-relaxed'>
						Release essays, architecture notes, and craft updates from DuneUI.
					</p>
				</div>

				<!-- Subscribe -->
				<form
					class='flex flex-col sm:flex-row gap-2.5 shrink-0'
					action='https://app.kit.com/forms/8415064/subscriptions'
					method='post'
				>
					<input
						type='email'
						required
						autocomplete='email'
						name='email_address'
						placeholder='your@email.com'
						aria-label='Email address'
						class='w-full sm:w-64 border border-rule-strong bg-paper-elevated py-2.5 px-4 font-accent text-sm text-ink placeholder:text-ink-muted focus:border-ink focus:outline-none transition-colors'
					/>
					<button
						type='submit'
						class='tactile-btn shrink-0 bg-ink px-5 py-2.5 font-mono text-xs font-semibold uppercase tracking-widest text-paper-elevated hover:bg-obsidian-soft cursor-pointer'
					>
						Subscribe
					</button>
				</form>
			</div>

			<!-- Count Rule -->
			<div class='flex items-center justify-between mb-8 font-mono text-[11px] uppercase tracking-widest text-ink-muted'>
				<span>PUBLISHED ARTICLES</span>
				<span>{posts.length} ENTRY{posts.length !== 1 ? 'IES' : ''}</span>
			</div>

			{posts.length > 0 ? (
				<div class='grid grid-cols-1 border-l border-t border-rule sm:grid-cols-2 lg:grid-cols-3'>
					{posts.map((post, i) => (
						<a
							href={`/blog/${post.id}/`}
							class='group flex flex-col justify-between border-b border-r border-rule bg-paper-elevated transition-colors hover:bg-paper'
						>
							<div>
								<div class='relative overflow-hidden border-b border-rule' style='aspect-ratio: 16/9;'>
									<Image
										src={post.data.heroImage || '/placeholder.svg'}
										alt={post.data.title}
										width={700}
										height={394}
										class='w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03] select-none'
										loading={i === 0 ? 'eager' : 'lazy'}
									/>
									{post.data.category && (
										<span class='absolute top-3 left-3 border border-ink bg-paper-elevated/95 px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-ink'>
											{post.data.category}
										</span>
									)}
								</div>

								<div class='p-6'>
									<div class='flex items-center justify-between font-mono text-[10px] uppercase tracking-wider text-ink-muted mb-3'>
										<time datetime={post.data.pubDate.toISOString()}>
											{formatDate(post.data.pubDate)}
										</time>
										{post.data.readTime && <span>{post.data.readTime} MIN READ</span>}
									</div>
									<h2 class='font-heading text-xl font-bold text-ink leading-snug group-hover:text-clay transition-colors'>
										{post.data.title}
									</h2>
									<p class='mt-2.5 font-accent text-sm text-ink-secondary leading-relaxed line-clamp-2'>
										{post.data.description}
									</p>
								</div>
							</div>

							<div class='flex items-center justify-between border-t border-rule/70 px-6 py-4'>
								<div class='flex items-center gap-2.5'>
									{post.data.writerImage ? (
										<img
											src={post.data.writerImage}
											alt={post.data.writer}
											class='size-7 object-cover border border-rule'
											loading='lazy'
										/>
									) : (
										<span class='size-7 bg-ink flex items-center justify-center font-mono text-[10px] font-bold text-paper-elevated shrink-0'>
											{getInitials(post.data.writer)}
										</span>
									)}
									<span class='font-accent text-xs font-semibold text-ink'>
										{post.data.writer}
									</span>
								</div>
								<span class='font-mono text-xs text-clay'>Read →</span>
							</div>
						</a>
					))}
				</div>
			) : (
				<div class='border border-rule bg-paper-elevated py-20 px-6 text-center'>
					<span class='font-mono text-xs uppercase tracking-widest text-clay'>ARCHIVE // EMPTY</span>
					<p class='mt-3 font-heading text-2xl font-bold text-ink'>No journal dispatches published yet</p>
					<p class='mt-2 mx-auto max-w-md font-accent text-sm text-ink-secondary'>
						Meanwhile, inspect our latest v2.0 release notes in the changelog or explore the component directory.
					</p>
					<div class='mt-7 flex flex-wrap justify-center gap-3'>
						<a href='/changelog' class='tactile-btn bg-ink px-5 py-2.5 font-mono text-xs font-semibold uppercase tracking-wider text-paper-elevated'>
							View Changelog ↗
						</a>
						<a href='/components' class='border border-rule-strong bg-paper px-5 py-2.5 font-mono text-xs font-medium uppercase tracking-wider text-ink hover:border-ink'>
							Browse Components
						</a>
					</div>
				</div>
			)}
		</Container>
	</div>
</Layout>
