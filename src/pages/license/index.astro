---
import Layout from '@/layouts/Layout.astro'
import Container from '@/core/components/Container.astro'

const allowed = [
  { title: 'Personal projects', desc: 'Build your portfolio, blog, or side project with zero restrictions.' },
  { title: 'Commercial projects', desc: 'Ship client work, SaaS apps, or commercial products freely.' },
  { title: 'Modify & customize', desc: 'Adapt any component to your design system. Once copied, it is yours.' },
  { title: 'Client deliverables', desc: 'Deliver websites and apps for clients without extra fees.' },
  { title: 'Open-source repos', desc: 'Include DuneUI markup in your public open-source repositories.' },
  { title: 'No attribution required', desc: 'Credit is never mandatory — though always appreciated.' },
]

const notAllowed = [
  { title: 'Repackage as a UI kit', desc: 'Do not bundle DuneUI components into a competing component library.' },
  { title: 'Sell standalone blocks', desc: 'Do not sell DuneUI components or sections as standalone design assets.' },
  { title: 'Template marketplace resale', desc: 'Do not convert sections into themes to resell on template marketplaces.' },
]

const cases = [
  { label: 'Personal website or portfolio', ok: true },
  { label: 'Client website or agency build', ok: true },
  { label: 'Commercial SaaS application', ok: true },
  { label: 'Open-source project', ok: true },
  { label: 'E-commerce storefront', ok: true },
  { label: 'Selling as a UI kit or Tailwind library', ok: false },
  { label: 'Template marketplace listing', ok: false },
  { label: 'Re-publishing on a competing component site', ok: false },
]
---

<Layout
  title='License · DuneUI'
  description='Learn how you can use DuneUI components in your personal and commercial projects.'
>
  <div class='bg-paper py-14 sm:py-20'>
    <Container>
      <div class='max-w-4xl mx-auto flex flex-col gap-16'>
        <!-- Header -->
        <div class='border-b border-rule pb-10'>
          <div class='flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-clay mb-3'>
            <span>LEGAL</span>
            <span class='text-rule-strong'>/</span>
            <span>FREE &amp; OPEN</span>
          </div>
          <h1 class='font-heading text-4xl sm:text-6xl font-bold text-ink leading-[1.02] tracking-tight'>
            License &amp;{' '}
            <span class='font-serif italic font-normal text-clay'>usage rights.</span>
          </h1>
          <p class='mt-4 font-accent text-base text-ink-secondary leading-relaxed max-w-lg'>
            Plain-language terms for using DuneUI in personal, client, and commercial software.
          </p>
        </div>

        <!-- TL;DR Box -->
        <div class='border border-ink bg-paper-elevated p-6 sm:p-8 shadow-[5px_5px_0_0_#DDD5C7]'>
          <span class='font-mono text-[11px] font-semibold uppercase tracking-widest text-clay'>SUMMARY // TL;DR</span>
          <p class='mt-2 font-heading text-2xl font-bold text-ink'>
            Use it freely in any product. Just don’t resell it as a library.
          </p>
          <p class='mt-2 font-accent text-sm text-ink-secondary leading-relaxed'>
            Every component and template may be used in unlimited personal or commercial projects. The only boundary is redistributing DuneUI as your own competing UI kit or template product.
          </p>
        </div>

        <!-- Permitted -->
        <section>
          <div class='flex items-center gap-3 mb-6'>
            <span class='font-mono text-xs font-semibold text-emerald-700'>01</span>
            <h2 class='font-heading text-xl font-bold text-ink'>Permitted Uses</h2>
            <div class='flex-1 h-px bg-rule'></div>
          </div>

          <div class='grid grid-cols-1 border-l border-t border-rule sm:grid-cols-2 lg:grid-cols-3'>
            {allowed.map(item => (
              <div class='border-b border-r border-rule bg-paper-elevated p-5'>
                <span class='font-mono text-[10px] font-semibold uppercase tracking-wider text-emerald-700'>✓ ALLOWED</span>
                <p class='mt-2 font-heading text-base font-bold text-ink'>{item.title}</p>
                <p class='mt-1.5 font-accent text-xs text-ink-secondary leading-relaxed'>{item.desc}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Prohibited -->
        <section>
          <div class='flex items-center gap-3 mb-6'>
            <span class='font-mono text-xs font-semibold text-clay'>02</span>
            <h2 class='font-heading text-xl font-bold text-ink'>Restricted Uses</h2>
            <div class='flex-1 h-px bg-rule'></div>
          </div>

          <div class='grid grid-cols-1 border-l border-t border-rule sm:grid-cols-3'>
            {notAllowed.map(item => (
              <div class='border-b border-r border-rule bg-paper-elevated p-5'>
                <span class='font-mono text-[10px] font-semibold uppercase tracking-wider text-clay'>× PROHIBITED</span>
                <p class='mt-2 font-heading text-base font-bold text-ink'>{item.title}</p>
                <p class='mt-1.5 font-accent text-xs text-ink-secondary leading-relaxed'>{item.desc}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Use Case Matrix -->
        <section>
          <div class='flex items-center gap-3 mb-6'>
            <span class='font-mono text-xs font-semibold text-ink-muted'>03</span>
            <h2 class='font-heading text-xl font-bold text-ink'>Use Case Matrix</h2>
            <div class='flex-1 h-px bg-rule'></div>
          </div>

          <div class='divide-y divide-rule border border-rule bg-paper-elevated'>
            {cases.map((c) => (
              <div class='flex items-center justify-between gap-4 px-5 py-3.5'>
                <span class='font-accent text-sm text-ink'>{c.label}</span>
                {c.ok ? (
                  <span class='border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-emerald-800'>
                    Allowed
                  </span>
                ) : (
                  <span class='border border-red-200 bg-red-50 px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-red-700'>
                    Not allowed
                  </span>
                )}
              </div>
            ))}
          </div>
        </section>
      </div>
    </Container>
  </div>
</Layout>
