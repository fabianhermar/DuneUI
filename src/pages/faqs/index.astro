---
import Layout from '@/layouts/Layout.astro'
import Container from '@/core/components/Container.astro'

const groups = [
  {
    id: 'general',
    index: '01',
    label: 'General',
    items: [
      {
        q: 'What is DuneUI?',
        a: 'DuneUI is a free, open-source library of UI components and page sections built with TailwindCSS v4 and pure CSS. Designed to help you ship distinct interfaces faster — no account required, no lock-in.',
      },
      {
        q: 'Is DuneUI completely free?',
        a: 'Yes. Every component is free for personal and commercial projects. No payment, no attribution needed.',
      },
      {
        q: 'Do I need to create an account?',
        a: 'No. All components are accessible directly from the website. Just browse, inspect at any viewport, and copy the code.',
      },
      {
        q: 'Who is DuneUI made for?',
        a: 'Developers and designers who want production-ready UI blocks without generic bloat. Whether you are building a SaaS, a studio site, or a personal archive — DuneUI gives you solid architectural primitives.',
      },
    ],
  },
  {
    id: 'components',
    index: '02',
    label: 'Components',
    items: [
      {
        q: 'Which frameworks are supported?',
        a: 'Components are written in semantic HTML + TailwindCSS v4 (plus pure CSS options), making them compatible with React, Vue, Svelte, Astro, Next.js, and vanilla HTML.',
      },
      {
        q: 'Can I modify the components?',
        a: 'Absolutely. Components are a starting point, not a constraint. Modify tokens, spacing, layout, and typography however you want.',
      },
      {
        q: 'Are the components accessible?',
        a: 'We follow accessibility best practices including semantic HTML, ARIA attributes, and keyboard navigation across interactive primitives.',
      },
      {
        q: 'Which TailwindCSS version is used?',
        a: 'As of v2.0, DuneUI is built for TailwindCSS v4 alongside standalone Pure CSS specimens.',
      },
    ],
  },
  {
    id: 'license',
    index: '03',
    label: 'License & Usage',
    items: [
      {
        q: 'Can I use DuneUI in commercial projects?',
        a: 'Yes. Use any component in commercial projects — SaaS apps, client websites, e-commerce stores, and more.',
      },
      {
        q: 'Can I redistribute components as a UI library?',
        a: 'No. You cannot package DuneUI components into a competing UI kit or component package and distribute it publicly, whether for free or for sale.',
      },
      {
        q: 'Do I need to credit DuneUI?',
        a: 'Attribution is not required. A mention is always appreciated and helps the project grow, but it is entirely optional.',
      },
    ],
  },
  {
    id: 'technical',
    index: '04',
    label: 'Technical',
    items: [
      {
        q: 'Do I need to install a package?',
        a: 'No. DuneUI is copy-paste based. Set up TailwindCSS v4 (or drop in our Pure CSS blocks) and paste the markup directly.',
      },
      {
        q: 'What fonts does DuneUI use?',
        a: 'DuneUI pairs Instrument Serif, Urbanist, Albert Sans, and JetBrains Mono via @fontsource. You can swap them for your own font tokens anytime.',
      },
    ],
  },
]
---

<Layout
  title='FAQs · DuneUI'
  description='Frequently asked questions about DuneUI — components, licensing, usage, and more.'
>
  <div class='bg-paper py-14 sm:py-20'>
    <Container>
      <div class='max-w-4xl mx-auto'>
        <div class='border-b border-rule pb-10 mb-14'>
          <div class='flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-clay mb-3'>
            <span>SUPPORT</span>
            <span class='text-rule-strong'>/</span>
            <span>FREQUENTLY ASKED</span>
          </div>
          <h1 class='font-heading text-4xl sm:text-6xl font-bold text-ink leading-[1.02] tracking-tight'>
            Questions &amp;{' '}
            <span class='font-serif italic font-normal text-clay'>answers.</span>
          </h1>
          <p class='mt-4 font-accent text-base text-ink-secondary leading-relaxed max-w-xl'>
            Everything you need to know about DuneUI. Need something specific?{' '}
            <a href='https://x.com/FabianHermar' target='_blank' rel='noopener noreferrer' class='text-clay font-semibold underline underline-offset-4 hover:text-clay-deep'>
              Reach out on X / Twitter.
            </a>
          </p>
        </div>

        <div class='flex flex-col gap-14' id='faq-root'>
          {groups.map((group) => (
            <section>
              <div class='flex items-center gap-3 mb-5'>
                <span class='font-mono text-xs font-semibold text-clay'>{group.index}</span>
                <h2 class='font-heading text-xl font-bold text-ink'>{group.label}</h2>
                <div class='flex-1 h-px bg-rule'></div>
              </div>

              <div class='divide-y divide-rule border border-rule bg-paper-elevated'>
                {group.items.map((item) => (
                  <div class='faq-item'>
                    <button
                      type='button'
                      class='faq-trigger flex w-full cursor-pointer items-start justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-paper'
                      aria-expanded='false'
                    >
                      <span class='font-accent text-sm sm:text-base font-semibold text-ink leading-snug'>
                        {item.q}
                      </span>
                      <span class='faq-chevron shrink-0 font-mono text-base text-clay transition-transform duration-200'>
                        +
                      </span>
                    </button>
                    <div class='faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out'>
                      <p class='px-6 pb-5 font-accent text-sm text-ink-secondary leading-relaxed'>
                        {item.a}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          ))}
        </div>

        <div class='mt-20 border border-ink bg-obsidian px-8 py-10 text-paper-elevated flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6'>
          <div>
            <p class='font-mono text-[11px] uppercase tracking-[0.2em] text-sand mb-2'>STILL STUCK?</p>
            <h3 class='font-heading text-2xl font-bold'>Ask directly on X / Twitter</h3>
            <p class='mt-1 font-accent text-sm text-white/70'>
              Have a question about integration, licensing, or upcoming components?
            </p>
          </div>
          <a
            href='https://x.com/FabianHermar'
            target='_blank'
            rel='noreferrer noopener'
            class='shrink-0 inline-flex items-center gap-2 bg-sand px-6 py-3 font-mono text-xs font-semibold uppercase tracking-widest text-obsidian hover:bg-paper-elevated transition-colors'
          >
            <span>Message @FabianHermar</span>
            <span aria-hidden='true'>↗</span>
          </a>
        </div>
      </div>
    </Container>
  </div>
</Layout>

<script>
  function initFaq() {
    document.querySelectorAll<HTMLButtonElement>('.faq-trigger').forEach(btn => {
      if (btn.getAttribute('data-bound') === 'true') return
      btn.setAttribute('data-bound', 'true')

      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item')!
        const body = item.querySelector<HTMLElement>('.faq-body')!
        const chevron = item.querySelector<HTMLElement>('.faq-chevron')!
        const isOpen = btn.getAttribute('aria-expanded') === 'true'

        const group = item.closest('section')!
        group.querySelectorAll('.faq-item').forEach(other => {
          if (other !== item) {
            other.querySelector<HTMLButtonElement>('.faq-trigger')!.setAttribute('aria-expanded', 'false')
            other.querySelector<HTMLElement>('.faq-body')!.style.maxHeight = '0'
            const oc = other.querySelector<HTMLElement>('.faq-chevron')!
            oc.style.transform = ''
            oc.textContent = '+'
          }
        })

        if (isOpen) {
          btn.setAttribute('aria-expanded', 'false')
          body.style.maxHeight = '0'
          chevron.style.transform = ''
          chevron.textContent = '+'
        } else {
          btn.setAttribute('aria-expanded', 'true')
          body.style.maxHeight = body.scrollHeight + 'px'
          chevron.style.transform = 'rotate(45deg)'
        }
      })
    })
  }

  initFaq()
  document.addEventListener('astro:page-load', initFaq)
</script>
