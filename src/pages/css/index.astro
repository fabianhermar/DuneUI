---
import Layout from '@/layouts/Layout.astro'
import Container from '@/core/components/Container.astro'
import { CARDS } from '@/constants/Card'

const surprises = [
	{
		index: '01',
		tag: 'NATIVE TOKENS',
		title: 'Zero-Compiler Portability',
		description:
			'Standalone HTML + CSS custom property packs engineered to drop cleanly into static sites, Rails, PHP, or minimal stacks without Tailwind.'
	},
	{
		index: '02',
		tag: 'MODERN CASCADE',
		title: 'Pure CSS Interactivity',
		description:
			'Adaptive cards, disclosure panels, and themeable switches powered strictly by native :has(), @container queries, and baseline nesting.'
	},
	{
		index: '03',
		tag: 'LAUNCH SURPRISES',
		title: 'Unexpected Drops Ahead',
		description:
			'We are preparing bonus interactive primitives, motion presets, and exclusive layouts that will debut alongside our Pure CSS release.'
	}
]
---

<Layout
	title='Pure CSS · Coming Soon · DuneUI'
	description='DuneUI Pure CSS primitives are coming soon with exciting surprises on the way. Explore the complete Tailwind CSS component library available right now.'
>
	<section class='border-b border-rule bg-paper pt-12 pb-20 sm:pt-16 sm:pb-28'>
		<Container>
			<!-- Top Back Link -->
			<a
				href='/components'
				class='group inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-ink-muted hover:text-ink transition-colors mb-8'
			>
				<span class='transition-transform group-hover:-translate-x-0.5'>&larr;</span>
				<span>Back to Tailwind Components</span>
			</a>

			<!-- Coming Soon Hero Split -->
			<div class='grid grid-cols-1 items-center gap-10 border-b border-rule pb-14 lg:grid-cols-12 lg:gap-14'>
				<div class='lg:col-span-7'>
					<div class='inline-flex flex-wrap items-center gap-2.5 border border-rule-strong bg-paper-elevated px-3.5 py-1.5 font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-clay'>
						<span class='size-2 rounded-full bg-clay animate-pulse'></span>
						<span>CSS ENGINE</span>
						<span class='text-rule-strong'>/</span>
						<span>COMING SOON</span>
						<span class='text-rule-strong'>/</span>
						<span>SURPRISES ON THE WAY</span>
					</div>

					<h1 class='mt-5 font-heading text-4xl font-bold leading-[1.02] tracking-tight text-ink sm:text-6xl'>
						Pure CSS primitives.{' '}
						<span class='block mt-1.5 font-serif italic font-normal text-clay'>
							Coming very soon.
						</span>
					</h1>

					<p class='mt-5 max-w-2xl font-accent text-base leading-relaxed text-ink-secondary'>
						We&rsquo;re building something special for zero-compiler stacks&mdash;token-driven CSS modules, native container-query primitives, and a few unexpected surprises on the way. While the Pure CSS edition isn&rsquo;t unlocked just yet, our complete{' '}
						<strong class='font-semibold text-ink'>Tailwind CSS edition</strong> is live and ready to copy-paste today.
					</p>

					<!-- Live Availability Callout Banner -->
					<div class='mt-7 flex flex-col gap-3 border border-rule-strong bg-paper-elevated p-4 sm:flex-row sm:items-center sm:justify-between'>
						<div class='flex items-start gap-3'>
							<span class='mt-1 size-2 shrink-0 bg-emerald-600'></span>
							<div>
								<p class='font-mono text-xs font-bold uppercase tracking-wider text-ink'>
									Available Right Now: Tailwind CSS Version
								</p>
								<p class='mt-0.5 font-accent text-xs text-ink-secondary'>
									All {CARDS.length} component families, live mobile-to-desktop previews, and interactive states are unlocked for Tailwind.
								</p>
							</div>
						</div>
						<a
							href='/components'
							class='shrink-0 inline-flex items-center justify-center gap-2 bg-obsidian px-4 py-2.5 font-mono text-xs font-semibold uppercase tracking-wider text-paper-elevated transition-colors hover:bg-clay'
						>
							<span>Open Tailwind Kit</span>
							<span aria-hidden='true'>&rarr;</span>
						</a>
					</div>

					<div class='mt-7 flex flex-wrap items-center gap-3'>
						<a
							href='/components'
							class='inline-flex items-center gap-2 border border-ink bg-ink px-5 py-3 font-mono text-xs font-semibold uppercase tracking-wider text-paper-elevated transition-colors hover:bg-clay hover:border-clay'
						>
							<span>Explore {CARDS.length} Tailwind Categories</span>
							<span aria-hidden='true'>&rarr;</span>
						</a>
						<a
							href='/icons'
							class='inline-flex items-center gap-2 border border-rule-strong bg-paper-elevated px-5 py-3 font-mono text-xs font-semibold uppercase tracking-wider text-ink transition-colors hover:border-ink'
						>
							<span>Browse SVG Icons</span>
						</a>
					</div>
				</div>

				<!-- Right Release Status Architectural Panel -->
				<div class='lg:col-span-5'>
					<div class='border border-rule-strong bg-paper-elevated p-5 sm:p-7 shadow-[6px_6px_0_0_#DDD5C7]'>
						<div class='flex items-center justify-between border-b border-rule pb-4 font-mono text-[11px] text-ink-muted'>
							<span class='font-semibold text-clay'>PURE_CSS_ROADMAP</span>
							<span>STATUS LOG</span>
						</div>

						<div class='mt-5 space-y-3.5'>
							<div class='flex items-center justify-between gap-3 border border-rule bg-paper p-3.5'>
								<div>
									<p class='font-mono text-xs font-bold text-ink'>Tailwind CSS v4 Catalog</p>
									<p class='mt-0.5 font-accent text-xs text-ink-secondary'>{CARDS.length} categories ready to ship</p>
								</div>
								<span class='shrink-0 border border-emerald-700/20 bg-emerald-50 px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-emerald-800'>
									Live Now
								</span>
							</div>

							<div class='flex items-center justify-between gap-3 border border-rule bg-paper p-3.5'>
								<div>
									<p class='font-mono text-xs font-bold text-ink'>Pure CSS Primitives</p>
									<p class='mt-0.5 font-accent text-xs text-ink-secondary'>Native tokens &amp; zero dependencies</p>
								</div>
								<span class='shrink-0 border border-clay/30 bg-sand/30 px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-clay-deep'>
									Coming Soon
								</span>
							</div>

							<div class='flex items-center justify-between gap-3 border border-rule bg-paper p-3.5'>
								<div>
									<p class='font-mono text-xs font-bold text-ink'>Bonus Launch Surprises</p>
									<p class='mt-0.5 font-accent text-xs text-ink-secondary'>Interactive motion &amp; secret kits</p>
								</div>
								<span class='shrink-0 border border-ink bg-obsidian px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-sand'>
									Stay Tuned
								</span>
							</div>
						</div>

						<div class='mt-5 flex flex-wrap items-center justify-between gap-2 bg-obsidian px-4 py-3 font-mono text-[11px] text-paper-elevated'>
							<span>
								<span class='text-sand'>--dune-css-kit:</span>{' '}
								<span>&quot;coming-soon&quot;;</span>
							</span>
							<a href='/changelog' class='text-sand hover:underline'>Changelog &rarr;</a>
						</div>
					</div>
				</div>
			</div>

			<!-- What's Brewing Teaser Grid -->
			<div class='pt-12'>
				<div class='mb-7 flex flex-wrap items-end justify-between gap-4'>
					<div>
						<p class='font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-clay'>
							PREVIEW OF WHAT&rsquo;S BREWING
						</p>
						<h2 class='mt-1.5 font-heading text-2xl font-bold tracking-tight text-ink sm:text-3xl'>
							Surprises arriving in the Pure CSS release
						</h2>
					</div>
					<a
						href='/changelog'
						class='font-mono text-xs uppercase tracking-wider text-clay hover:text-clay-deep hover:underline'
					>
						Follow updates &rarr;
					</a>
				</div>

				<div class='grid grid-cols-1 gap-5 md:grid-cols-3'>
					{
						surprises.map((item) => (
							<article class='flex flex-col justify-between border border-rule bg-paper-elevated p-6 transition-colors hover:border-rule-strong'>
								<div>
									<div class='flex items-center justify-between font-mono text-[10px] font-semibold uppercase tracking-widest'>
										<span class='text-clay'>{item.tag}</span>
										<span class='text-ink-muted'>{item.index}</span>
									</div>
									<h3 class='mt-3 font-heading text-lg font-bold text-ink'>
										{item.title}
									</h3>
									<p class='mt-2 font-accent text-sm leading-relaxed text-ink-secondary'>
										{item.description}
									</p>
								</div>
								<div class='mt-5 border-t border-rule pt-3 font-mono text-[10px] uppercase tracking-wider text-ink-muted'>
									Unlocking soon
								</div>
							</article>
						))
					}
				</div>
			</div>
		</Container>
	</section>
</Layout>
