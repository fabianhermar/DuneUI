---
import Layout from '@/layouts/Layout.astro'
import Container from '@/core/components/Container.astro'
import { getCollection } from 'astro:content'

const entries = (await getCollection('changelog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)

function formatDate(date: Date) {
	return date.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })
}

const tagStyles: Record<string, string> = {
	New: 'bg-emerald-50 text-emerald-800 border-emerald-200',
	Improved: 'bg-sky-50 text-sky-800 border-sky-200',
	Fixed: 'bg-amber-50 text-amber-800 border-amber-200',
	Breaking: 'bg-red-50 text-red-800 border-red-200'
}
---

<Layout
	title='Changelog · DuneUI'
	description='Every update, new component, bug fix, and improvement shipped to DuneUI.'
>
	<div class='bg-paper py-14 sm:py-20'>
		<Container>
			<div class='max-w-4xl mx-auto'>
				<!-- Header -->
				<div class='border-b border-rule pb-10 mb-12'>
					<div class='flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-clay mb-3'>
						<span>LOG</span>
						<span class='text-rule-strong'>/</span>
						<span>RELEASE HISTORY</span>
					</div>
					<div class='flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4'>
						<h1 class='font-heading text-4xl sm:text-6xl font-bold text-ink leading-[1.02] tracking-tight'>
							Changelog
						</h1>
						<span class='font-mono text-xs uppercase tracking-widest text-ink-muted'>
							{entries.length} RELEASE{entries.length !== 1 ? 'S' : ''}
						</span>
					</div>
					<p class='mt-4 max-w-lg font-accent text-base text-ink-secondary leading-relaxed'>
						Every architectural update, new component specimen, and refinement shipped to DuneUI.
					</p>
				</div>

				<!-- Ruled Timeline -->
				<div class='divide-y divide-rule border-t border-b border-rule'>
					{entries.map((entry, i) => (
						<a
							href={`/changelog/${entry.id}/`}
							class='group grid grid-cols-1 gap-6 py-9 transition-colors hover:bg-paper-elevated sm:grid-cols-12 sm:px-4'
						>
							<div class='sm:col-span-3 flex flex-col gap-2'>
								<span class='inline-block w-max border border-ink bg-ink px-2.5 py-0.5 font-mono text-xs font-bold text-paper-elevated'>
									{entry.data.version}
								</span>
								<time
									class='font-mono text-xs text-ink-muted uppercase tracking-wider'
									datetime={entry.data.pubDate.toISOString()}
								>
									{formatDate(entry.data.pubDate)}
								</time>
							</div>

							<div class='sm:col-span-9'>
								<div class='flex flex-wrap items-center gap-2 mb-3'>
									{entry.data.tags?.map(tag => (
										<span class={`border px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider ${tagStyles[tag] ?? 'bg-paper-recessed text-ink-secondary border-rule'}`}>
											{tag}
										</span>
									))}
								</div>

								<h2 class='font-heading text-2xl font-bold text-ink leading-snug group-hover:text-clay transition-colors'>
									{entry.data.title}
								</h2>

								<p class='mt-2 font-accent text-sm text-ink-secondary leading-relaxed'>
									{entry.data.description}
								</p>

								{entry.data.image && (
									<div class='mt-5 border border-rule bg-paper p-1.5'>
										<img
											src={entry.data.image}
											alt={entry.data.title}
											width={800}
											height={450}
											class='aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-[1.01] select-none'
											loading={i === 0 ? 'eager' : 'lazy'}
										/>
									</div>
								)}

								<span class='mt-5 inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wider text-clay'>
									<span>Read release notes</span>
									<span class='transition-transform group-hover:translate-x-1'>→</span>
								</span>
							</div>
						</a>
					))}
				</div>
			</div>
		</Container>
	</div>
</Layout>
