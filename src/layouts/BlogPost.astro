---
import type { CollectionEntry } from 'astro:content'
import Header from '@/core/components/Header.astro'
import Footer from '@/core/components/Footer.astro'
import '@/styles/globals.css'
import { ClientRouter } from 'astro:transitions'

type Props = CollectionEntry<'blog'>['data']

const {
	title,
	description,
	pubDate,
	readTime,
	updatedDate,
	heroImage,
	category,
	writer,
	writerImage,
	role
} = Astro.props

function formatDate(date: Date) {
	return date.toLocaleDateString('en-US', {
		day: 'numeric',
		month: 'long',
		year: 'numeric'
	}).toUpperCase()
}

function getInitials(name: string) {
	return name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2)
}

const canonicalUrl = `https://duneui.com/blog/`
---

<html lang='en'>
	<head>
		<title>{title} · DuneUI</title>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1' />
		<meta name='description' content={description} />
		<meta name='keywords' content='duneui, tailwindcss, components, templates, open-source' />
		<link rel='shortcut icon' href='/favicon/favicon.ico' type='image/x-icon' />
		<link rel='apple-touch-icon' sizes='180x180' href='/favicon/apple-touch-icon.png' />
		<link rel='icon' type='image/png' sizes='32x32' href='/favicon/favicon-32x32.png' />
		<link rel='icon' type='image/png' sizes='16x16' href='/favicon/favicon-16x16.png' />
		<link rel='manifest' href='/favicon/site.webmanifest' />
		<link rel='canonical' href={canonicalUrl} />
		<meta name='apple-mobile-web-app-title' content='DuneUI' />
		<meta property='og:type' content='article' />
		<meta property='og:title' content={title} />
		<meta property='og:description' content={description} />
		<meta property='og:image' content={heroImage ?? 'https://res.cloudinary.com/dvjzjasfg/image/upload/v1694909149/DuneUI_v1.0_qu7myh.png'} />
		<meta property='og:site_name' content='DuneUI' />
		<meta name='twitter:card' content='summary_large_image' />
		<meta name='twitter:site' content='@FabianHermar' />
		<meta name='twitter:title' content={title} />
		<meta name='twitter:description' content={description} />
		<ClientRouter />
	</head>

	<body class='relative flex min-h-screen flex-col bg-paper text-ink antialiased'>
		<div aria-hidden='true' class='paper-grain pointer-events-none fixed inset-0 z-50 opacity-[0.032] mix-blend-multiply'></div>
		<Header />

		<main class='flex-1 py-14 sm:py-20'>
			<div class='mx-auto w-full max-w-3xl px-5 sm:px-8'>
				<a
					href='/blog'
					class='inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-ink-muted hover:text-ink transition-colors mb-8 group'
				>
					<span class='transition-transform group-hover:-translate-x-0.5'>←</span>
					<span>Back to journal</span>
				</a>

				<div class='flex flex-wrap items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-clay mb-4'>
					{category && <span>{category}</span>}
					{category && <span class='text-rule-strong'>/</span>}
					<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
					{readTime && (
						<>
							<span class='text-rule-strong'>/</span>
							<span>{readTime} MIN READ</span>
						</>
					)}
				</div>

				<h1 class='font-heading text-4xl sm:text-5xl font-bold text-ink leading-[1.06] tracking-tight mb-8'>
					{title}
				</h1>

				<div class='flex items-center justify-between border-y border-rule py-4 mb-10'>
					<div class='flex items-center gap-3'>
						{writerImage ? (
							<img
								src={writerImage}
								alt={writer}
								class='size-9 object-cover border border-rule'
								loading='lazy'
							/>
						) : (
							<span class='size-9 bg-ink flex items-center justify-center font-mono text-xs font-bold text-paper-elevated shrink-0'>
								{getInitials(writer)}
							</span>
						)}
						<div>
							<p class='font-accent text-sm font-semibold text-ink leading-tight'>{writer}</p>
							{role && <p class='font-mono text-[10px] uppercase tracking-wider text-ink-muted leading-tight mt-0.5'>{role}</p>}
						</div>
					</div>

					<button
						id='copy-link-btn'
						type='button'
						class='inline-flex items-center gap-2 border border-rule bg-paper-elevated px-3.5 py-2 font-mono text-[11px] uppercase tracking-wider text-ink-secondary hover:border-ink hover:text-ink transition-colors cursor-pointer'
					>
						Copy link
					</button>
				</div>

				{heroImage && (
					<div class='w-full border border-rule bg-paper-elevated p-2 mb-12'>
						<img
							src={heroImage}
							alt={title}
							width={800}
							height={450}
							class='w-full object-cover'
							loading='eager'
						/>
					</div>
				)}

				<div class='prose prose-neutral md:prose-lg prose-headings:font-heading prose-headings:text-ink prose-p:text-ink-secondary prose-a:text-clay prose-a:no-underline hover:prose-a:underline prose-blockquote:border-l-clay prose-code:text-clay prose-pre:bg-obsidian max-w-none font-accent prose-p:leading-relaxed marker:text-clay'>
					<slot />
				</div>

				{updatedDate && (
					<p class='mt-10 font-mono text-xs text-ink-muted uppercase tracking-wider'>
						Last updated // {formatDate(updatedDate)}
					</p>
				)}

				<div class='mt-14 pt-8 border-t border-rule'>
					<a
						href='/blog'
						class='inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-widest text-clay hover:text-clay-deep transition-colors'
					>
						<span>←</span>
						<span>Back to all articles</span>
					</a>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>

<script>
	const btn = document.getElementById('copy-link-btn')
	btn?.addEventListener('click', async () => {
		try {
			await navigator.clipboard.writeText(window.location.href)
			const original = btn.textContent
			btn.textContent = 'Copied!'
			btn.classList.add('border-clay', 'text-clay')
			setTimeout(() => {
				btn.textContent = original
				btn.classList.remove('border-clay', 'text-clay')
			}, 2000)
		} catch {}
	})
</script>
