---
import type { CollectionEntry } from 'astro:content'
import Header from '@/core/components/Header.astro'
import Footer from '@/core/components/Footer.astro'
import '@/styles/globals.css'
import { ClientRouter } from 'astro:transitions'

type Props = CollectionEntry<'changelog'>['data'] & { id: string }

const { title, version, description, pubDate, tags, image } = Astro.props

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  })
}

const tagStyles: Record<string, string> = {
  New: 'bg-emerald-50 text-emerald-800 border-emerald-200',
  Improved: 'bg-sky-50 text-sky-800 border-sky-200',
  Fixed: 'bg-amber-50 text-amber-800 border-amber-200',
  Breaking: 'bg-red-50 text-red-800 border-red-200',
}
---

<html lang='en'>
  <head>
    <title>{version} {title} · Changelog · DuneUI</title>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='description' content={description} />
    <link rel='shortcut icon' href='/favicon/favicon.ico' type='image/x-icon' />
    <link rel='icon' type='image/png' sizes='32x32' href='/favicon/favicon-32x32.png' />
    <link rel='icon' type='image/png' sizes='16x16' href='/favicon/favicon-16x16.png' />
    <link rel='manifest' href='/favicon/site.webmanifest' />
    <ClientRouter />
  </head>

  <body class='relative flex min-h-screen flex-col bg-paper text-ink antialiased'>
    <div aria-hidden='true' class='paper-grain pointer-events-none fixed inset-0 z-50 opacity-[0.032] mix-blend-multiply'></div>
    <Header />

    <main class='flex-1 py-14 sm:py-20'>
      <div class='mx-auto w-full max-w-3xl px-5 sm:px-8'>
        <a
          href='/changelog'
          class='inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-ink-muted hover:text-ink transition-colors mb-10 group'
        >
          <span class='transition-transform group-hover:-translate-x-0.5'>←</span>
          <span>Back to changelog</span>
        </a>

        <div class='flex flex-wrap items-center gap-2 mb-5'>
          <span class='border border-ink bg-ink px-3 py-1 font-mono text-xs font-bold text-paper-elevated tracking-wide'>
            {version}
          </span>
          {tags?.map(tag => (
            <span class={`border px-2.5 py-1 font-mono text-[11px] font-semibold uppercase tracking-wider ${tagStyles[tag] ?? 'bg-paper-recessed text-ink-secondary border-rule'}`}>
              {tag}
            </span>
          ))}
        </div>

        <h1 class='font-heading text-3xl sm:text-5xl font-bold text-ink leading-tight tracking-tight mb-3'>
          {title}
        </h1>

        <time class='font-mono text-xs uppercase tracking-wider text-ink-muted' datetime={pubDate.toISOString()}>
          {formatDate(pubDate)}
        </time>

        {image && (
          <div class='mt-8 w-full border border-rule bg-paper-elevated p-2'>
            <img
              src={image}
              alt={title}
              width={900}
              height={506}
              class='w-full aspect-video object-cover'
              loading='eager'
            />
          </div>
        )}

        <div class='h-px bg-rule my-10'></div>

        <div class='prose prose-neutral md:prose-lg max-w-none font-accent
          prose-headings:font-heading prose-headings:text-ink
          prose-h2:text-xl prose-h2:font-bold prose-h2:mt-10 prose-h2:mb-4 prose-h2:border-b prose-h2:border-rule prose-h2:pb-3
          prose-p:text-ink-secondary prose-p:leading-relaxed
          prose-li:text-ink-secondary
          prose-strong:text-ink prose-strong:font-semibold
          prose-a:text-clay prose-a:no-underline hover:prose-a:underline
          prose-code:text-clay prose-code:bg-paper-recessed prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-sm
          marker:text-clay
          prose-ul:mt-3 prose-li:mt-1'>
          <slot />
        </div>

        <div class='mt-16 pt-8 border-t border-rule flex items-center justify-between'>
          <a
            href='/changelog'
            class='inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-widest text-clay hover:text-clay-deep transition-colors'
          >
            <span>←</span>
            <span>All releases</span>
          </a>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
